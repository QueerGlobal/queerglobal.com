{
  "name": "QueerGlobal shared environment (queerglobal.com)",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "python3 --version && node --version && go version",
  "terminals": [
    {
      "name": "web",
      "command": "python3 -m http.server 8000"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 8000
    }
  ]
}
